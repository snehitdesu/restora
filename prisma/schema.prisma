// ============================================================
// Aharos — Restaurant Operating System
// Prisma schema
//
// DATABASE STRATEGY
// - Local dev: SQLite (zero external services). See note below.
// - Production: PostgreSQL (+ Row Level Security). Switch `provider`
//   to "postgresql" and point DATABASE_URL at Postgres. The schema is
//   written to be portable (see DATABASE.md).
//
// TENANCY ANCHORS (RLS-ready)
// - Every business row carries scalar `organizationId` (and `outletId`
//   where operational). These are the columns Postgres RLS policies
//   filter on, so they are denormalized onto every row on purpose and
//   indexed. Enforcement today lives in the data-access layer
//   (src/server/db/scope.ts); in production the same columns back RLS.
//
// ACTORS
// - `createdById` / actor columns reference User.id as indexed scalars
//   (traceability without a fragile mega back-relation on User). Auth-
//   critical relations (Session, Membership) are formal FKs.
//
// IMMUTABILITY
// - InventoryLedger, AuditLog, LoyaltyTransaction, PettyCashTxn and
//   Payment are append-only. Mistakes are fixed with CORRECTION rows
//   (self-relations correctionOfId / reversedById), never edits/deletes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local: sqlite. Production: change to "postgresql".
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANCY & IDENTITY
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  gstin     String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets     Outlet[]
  memberships Membership[]
  users       User[]

  @@index([active])
}

model Outlet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  address        String?
  gstin          String?
  phone          String?
  currency       String       @default("INR")
  timezone       String       @default("Asia/Kolkata")
  openTime       String? // "09:00"
  closeTime      String? // "23:30"
  // Invoice number series prefix (≤ 4 chars), e.g. "HYD" -> HYD/2627/00001.
  invoiceSeries  String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments Department[]
  floors      Floor[]
  memberships Membership[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name           String
  kind           String   @default("OTHER") // STORE | KITCHEN | BAR | BAKERY | PRODUCTION | OTHER
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([outletId, name])
  @@index([organizationId])
  @@index([outletId, kind])
}

model User {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email                String
  name                 String
  passwordHash         String
  phone                String?
  active               Boolean      @default(true)
  isSuperAdmin         Boolean      @default(false)
  lastLoginAt          DateTime?
  // Owner recovery key (H2): SHA-256 of a 150-bit key shown to the Owner once.
  // Only active org-wide OWNERs hold one; it rotates on every successful use.
  recoveryKeyHash      String?
  recoveryKeyCreatedAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships    Membership[]
  sessions       Session[]
  passwordTokens PasswordToken[]

  @@unique([email])
  @@index([organizationId, active])
}

// A user's role at a specific outlet (outletId null => organization-wide role).
model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outletId       String?
  outlet         Outlet?      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  // OWNER | AREA_MANAGER | ADMIN | MANAGER | STORE | KITCHEN | CAPTAIN | CASHIER | CUSTOMER | SUPER_ADMIN
  role           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, outletId, role])
  @@index([organizationId])
  @@index([outletId])
  @@index([userId, active])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  ip              String?
  userAgent       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  // Idle timeout (H3): last meaningful activity (null = createdAt). Written at
  // most once a minute; background polling never advances it.
  lastActivityAt  DateTime?
  // Step-up re-authentication grant: one scope, short-lived, bound to this session.
  reauthScope     String?
  reauthExpiresAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// One-time password setup (new staff) / reset links. Only the SHA-256 of the
// token is stored; a token is single-use (usedAt) and expires.
model PasswordToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        String // SETUP | RESET
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([organizationId])
}

// ============================================================
// MASTER DATA
// ============================================================

model Unit {
  id             String   @id @default(cuid())
  organizationId String
  code           String // "kg", "g", "L", "ml", "pc"
  name           String
  kind           String   @default("COUNT") // WEIGHT | VOLUME | COUNT
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials     Material[]        @relation("MaterialBaseUnit")
  ledgerEntries InventoryLedger[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Unit conversions. materialId null => global conversion (e.g. 1 kg = 1000 g).
model UnitConversion {
  id             String   @id @default(cuid())
  organizationId String
  fromUnitId     String
  toUnitId       String
  factor         Decimal // 1 fromUnit = factor * toUnit
  materialId     String? // material-specific override (e.g. 1 crate = 24 pc)
  createdAt      DateTime @default(now())

  @@unique([organizationId, fromUnitId, toUnitId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

model MaterialCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials Material[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Material {
  id                String            @id @default(cuid())
  organizationId    String
  sku               String
  name              String
  // The maker's brand ("Amul", "Tata Salt"): what the store looks for on the shelf and the vendor quotes against.
  brand             String?
  categoryId        String?
  category          MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnitId        String
  baseUnit          Unit              @relation("MaterialBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  purchaseUnitId    String?
  taxPct            Decimal           @default(0)
  minStock          Decimal           @default(0)
  reorderLevel      Decimal           @default(0)
  // Order-up-to level for the reorder engine (base unit). Empty: the reorder
  // level is the par (svc/reorder.ts).
  parLevel          Decimal?
  preferredVendorId String?
  perishable        Boolean           @default(false)
  trackBatch        Boolean           @default(false)
  active            Boolean           @default(true)
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledgerEntries InventoryLedger[]
  vendorLinks   VendorMaterial[]
  outletCosts   OutletMaterialCost[]
  recipeLines   RecipeLine[]         @relation("RecipeLineMaterial")

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@index([categoryId])
  @@index([baseUnitId])
}

// Weighted-average cost is per outlet (purchases differ by outlet).
model OutletMaterialCost {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  avgCost        Decimal  @default(0) // weighted-average unit cost in base unit
  lastCost       Decimal  @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  bankAccount    String?
  bankIfsc       String?
  paymentTerms   String? // "NET15", "COD"
  creditLimit    Decimal  @default(0)
  // UPI id for vendor payments (shown masked like bank details).
  upiId          String?
  // What kind of vendor (Dairy, Produce, Packaging ...) and the GST nature of supply: GOODS | SERVICES | BOTH.
  category       String?
  natureOfSupply String?
  // Mirrors status == ACTIVE (kept for existing filters); status is authoritative.
  active         Boolean  @default(true)
  // PENDING | ACTIVE | INACTIVE | BLACKLISTED (VENDOR_STATUS_TRANSITIONS). New
  // vendors start PENDING; buying (PO / GRN / bill) needs ACTIVE.
  status         String   @default("ACTIVE")
  statusReason   String?
  approvedById   String?
  approvedAt     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials VendorMaterial[]
  contacts  VendorContact[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([organizationId, status])
}

/// A person to call at a vendor (the account manager, the delivery desk, accounts): a vendor has several.
model VendorContact {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  phone          String?
  email          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([vendorId])
  @@index([organizationId])
}

model VendorMaterial {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lastRate       Decimal  @default(0)
  leadTimeDays   Int      @default(1)
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([vendorId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

// ============================================================
// MENU
// ============================================================

model MenuCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MenuItem {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  category       MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  price          Decimal       @default(0)
  taxPct         Decimal       @default(5)
  station        String        @default("KITCHEN") // routing hint for KOT: KITCHEN | BAR | BAKERY
  posCode        String? // external POS item code for mapping
  // HSN / SAC code for tax invoices (restaurant service: SAC 996331).
  hsnSac         String?
  // Comma-separated lower-case tags: "south-indian,breakfast". Cuisine / meal-type labels for filtering the menu.
  cuisineTags    String?
  isVeg          Boolean       @default(true)
  active         Boolean       @default(true)
  soldOut        Boolean       @default(false)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants        MenuItemVariant[]
  modifierGroups  MenuItemModifierGroup[]
  recipe          Recipe?                 @relation("MenuItemRecipe")
  orderItems      OrderItem[]
  outletOverrides OutletMenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([organizationId, posCode])
  @@index([categoryId])
}

// Per-outlet menu overrides. Absent row => the org-level MenuItem values apply.
model OutletMenuItem {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  price          Decimal? // null => MenuItem.price
  active         Boolean  @default(true) // false => not offered at this outlet
  soldOut        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, menuItemId])
  @@index([organizationId])
  @@index([menuItemId])
}

model MenuItemVariant {
  id                String   @id @default(cuid())
  organizationId    String
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name              String // "Half", "Full"
  priceDelta        Decimal  @default(0)
  // Inventory: this variant consumes this multiple of the item's recipe (Half = 0.5, Large = 1.5).
  consumptionFactor Decimal  @default(1)
  active            Boolean  @default(true)

  @@unique([menuItemId, name])
  @@index([organizationId])
}

model ModifierGroup {
  id             String  @id @default(cuid())
  organizationId String
  name           String // "Spice Level", "Add-ons"
  minSelect      Int     @default(0)
  maxSelect      Int     @default(1)
  active         Boolean @default(true)

  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ModifierOption {
  id             String        @id @default(cuid())
  organizationId String
  groupId        String
  group          ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceDelta     Decimal       @default(0)
  // Inventory: an add-on that uses stock (e.g. extra cheese = 30 g of Cheese per unit ordered).
  materialId     String?
  materialQty    Decimal?
  unitId         String?
  active         Boolean       @default(true)

  @@unique([groupId, name])
  @@index([organizationId])
}

model MenuItemModifierGroup {
  id         String        @id @default(cuid())
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, groupId])
  @@index([groupId])
}

// ============================================================
// RECIPES (recursive, versioned)
// ============================================================

model Recipe {
  id               String    @id @default(cuid())
  organizationId   String
  // A recipe produces either a menu item or a stockable sub-recipe material.
  outputType       String    @default("MENU_ITEM") // MENU_ITEM | SUB_RECIPE
  menuItemId       String?   @unique
  menuItem         MenuItem? @relation("MenuItemRecipe", fields: [menuItemId], references: [id], onDelete: Cascade)
  outputMaterialId String? // for SUB_RECIPE: the produced (semi-finished) material
  // SUB_RECIPE made in batches and held as prepared stock (group 3): dishes
  // draw on the output material instead of re-consuming the raw materials,
  // and only stocked recipes can be produced. Not stocked = made to order:
  // dishes explode through it to the raw materials.
  stocked          Boolean   @default(false)
  name             String
  active           Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions    RecipeVersion[]
  // Lines in OTHER recipes that reference this recipe as a sub-recipe.
  usedInLines RecipeLine[]    @relation("RecipeLineSubRecipe")

  @@index([organizationId, active])
  @@index([outputMaterialId])
}

model RecipeVersion {
  id             String    @id @default(cuid())
  organizationId String
  recipeId       String
  recipe         Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  effectiveFrom  DateTime  @default(now())
  yieldQty       Decimal   @default(1)
  yieldUnitId    String?
  servingSize    Decimal   @default(1)
  // Overhead added on top of ingredient cost (proposal p. 4): plate cost =
  // ingredients x (1 + overheadPct / 100). Food cost % stays ingredients only.
  overheadPct    Decimal   @default(0)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  lines RecipeLine[]

  @@unique([recipeId, version])
  @@index([organizationId])
  @@index([recipeId, status])
}

model RecipeLine {
  id              String        @id @default(cuid())
  organizationId  String
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  componentType   String // MATERIAL | SUB_RECIPE
  materialId      String?
  material        Material?     @relation("RecipeLineMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  subRecipeId     String?
  subRecipe       Recipe?       @relation("RecipeLineSubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  qty             Decimal
  unitId          String?
  wastagePct      Decimal       @default(0)
  sortOrder       Int           @default(0)

  @@index([recipeVersionId])
  @@index([organizationId])
  @@index([materialId])
  @@index([subRecipeId])
}

// ============================================================
// TABLES & FLOORS
// ============================================================

model Floor {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  tables RestaurantTable[]

  @@unique([outletId, name])
  @@index([organizationId])
}

model RestaurantTable {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  floorId        String?
  floor          Floor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  code           String // "T1"
  capacity       Int      @default(4)
  status         String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | ORDERING | PREPARING | READY | BILL_REQUESTED | BILLED | RESERVED | CLEANING
  qrToken        String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@unique([outletId, code])
  @@index([organizationId, outletId])
  @@index([outletId, status])
  @@index([floorId])
}

// ============================================================
// CUSTOMERS / CRM / LOYALTY
// ============================================================

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  birthday       DateTime?
  /// Group 6: anniversary offers (proposal p. 17).
  anniversary    DateTime?
  notes          String?
  /// Group 6: what the guest likes (diet, favourite table, allergies): staff-visible free text.
  preferences    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses    CustomerAddress[]
  loyalty      LoyaltyAccount?
  loyaltyTxns  LoyaltyTransaction[]
  orders       Order[]
  reservations Reservation[]
  feedback     Feedback[]
  consents     CustomerConsent[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String   @default("Home")
  line1          String
  line2          String?
  city           String?
  pincode        String?
  lat            Float?
  lng            Float?

  @@index([customerId])
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier           String   @default("SILVER")
  // Balance is a cache; the ledger (LoyaltyTransaction) is the source of truth.
  pointsBalance  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Append-only loyalty ledger. Never edit a balance directly.
model LoyaltyTransaction {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type           String // EARN | REDEEM | EXPIRE | ADJUST
  points         Int // signed: + earn, - redeem/expire
  orderId        String?
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())

  // Idempotency: at most one EARN (or REDEEM / reversal ADJUST) per customer per
  // order. NULL orderIds (manual adjustments) are distinct, so they are unaffected.
  @@unique([customerId, orderId, type])
  @@index([organizationId])
  @@index([customerId])
}

model Feedback {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId        String?
  rating         Int       @default(5)
  comment        String?
  createdAt      DateTime  @default(now())
  /// Group 6. STAFF (typed in by staff) | GUEST (the guest's own form on the order page or a feedback link).
  source         String    @default("STAFF")
  /// NEW | ACKNOWLEDGED | RESOLVED: a private complaint is worked like a task.
  status         String    @default("NEW")
  /// What the guest was shown after rating: GOOGLE (happy: a public review link) | PRIVATE (unhappy: reaches the manager).
  routedTo       String?
  handledById    String?
  handledAt      DateTime?
  resolution     String?

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status, createdAt])
  @@index([orderId])
}

model Reservation {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tableId        String?
  partySize      Int       @default(2)
  reservedAt     DateTime
  status         String    @default("BOOKED") // BOOKED | CONFIRMED | SEATED | COMPLETED | CANCELLED | NO_SHOW
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, outletId])
  @@index([outletId, reservedAt])
  @@index([customerId])
}

// Table occupancy locks: one row per (table, 15-minute slot) held by an active
// reservation. The unique constraint makes concurrent double-booking impossible
// at the database level on SQLite and PostgreSQL alike (see reservations.ts).
model ReservationSlot {
  id             String   @id @default(cuid())
  organizationId String
  tableId        String
  slot           DateTime // slot start (UTC, aligned to 15 minutes)
  reservationId  String
  createdAt      DateTime @default(now())

  @@unique([tableId, slot])
  @@index([reservationId])
  @@index([organizationId])
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  customerName   String
  phone          String?
  partySize      Int      @default(2)
  status         String   @default("WAITING") // WAITING | ARRIVED | SEATED | LEFT | CANCELLED
  estWaitMins    Int      @default(15)
  // When the party was last told its table is ready (message accepted by the message gate), and how many times.
  notifiedAt     DateTime?
  notifyCount    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, status])
}

// ============================================================
// ORDERS / POS / BILLING / PAYMENTS
// ============================================================

model Order {
  id             String           @id @default(cuid())
  organizationId String
  outletId       String
  channel        String           @default("DINE_IN") // DINE_IN | TAKEAWAY | DELIVERY | QR | ONLINE | AGGREGATOR
  source         String           @default("POS") // POS | QR | ONLINE | PETPOOJA | MANUAL | ZOMATO | SWIGGY
  // Idempotency: (outletId, source, externalRef) is unique so a re-delivered
  // POS/webhook order cannot create a duplicate. See webhook + reconciliation.
  externalRef    String?
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         String           @default("OPEN") // OPEN | SENT | PREPARING | READY | SERVED | BILLED | PAID | CANCELLED | REFUNDED
  invoiceNo      String?
  subtotal       Decimal          @default(0)
  discount       Decimal          @default(0)
  tax            Decimal          @default(0)
  total          Decimal          @default(0)
  // Set true exactly once when the recipe explosion has depleted stock,
  // guarding against double consumption at the aggregate level.
  stockConsumed  Boolean          @default(false)
  covers         Int              @default(1)
  notes          String?
  // A bill saved at the counter without sending it to the kitchen ("held"): the POS's named hold list is the OPEN orders
  // that carry heldAt. The label is what the cashier called it ("window table", "Ravi").
  holdLabel      String?
  heldAt         DateTime?
  // Client-supplied Idempotency-Key for order creation: a retry returns the
  // original order; reuse with a different request is rejected (requestHash).
  idempotencyKey String?
  requestHash    String?
  // B2B buyer details for the tax invoice (set before the invoice is issued).
  buyerGstin     String?
  buyerName      String?
  createdById    String?
  billedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items    OrderItem[]
  payments Payment[]
  kots     Kot[]
  rounds   OrderRound[]

  @@unique([outletId, invoiceNo])
  @@unique([outletId, source, externalRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
  @@index([outletId, status])
  @@index([customerId])
  @@index([tableId, status])
}

model OrderItem {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  posItemCode    String? // captured even when unmapped
  // The menu variant ordered (drives its recipe consumption factor).
  variantId      String?
  name           String // snapshot of item name at time of order
  qty            Decimal   @default(1)
  unitPrice      Decimal   @default(0)
  discount       Decimal   @default(0)
  taxPct         Decimal   @default(0)
  lineTotal      Decimal   @default(0)
  // Plate cost of ONE standard portion when the sale consumed stock: the dish's
  // recipe at the average costs used for the ledger rows, without add-ons and
  // with a variant's consumption factor divided out, times (1 + the recipe's
  // overhead % at that moment); null = no recipe, e.g. unmapped. Frozen: the
  // historical plate cost behind menu engineering, comparable with today's
  // plate cost of the same dish; neither ingredient prices nor a later overhead
  // edit change it.
  unitCost       Decimal?
  // Everything the line consumed (recipe x qty x variant factor + stock-consuming
  // add-ons) at those costs: the line's real cost of goods (null = no recipe).
  lineCost       Decimal?
  // HSN / SAC snapshot at order time.
  hsnSac         String?
  station        String    @default("KITCHEN")
  notes          String?
  createdAt      DateTime  @default(now())

  modifiers OrderItemModifier[]
  kotItems  KotItem[]

  @@index([orderId])
  @@index([organizationId, outletId])
  @@index([menuItemId])
}

/// One "round" of items added to a running order (captain / POS) with its
/// Idempotency-Key: a retried round returns the original instead of adding the
/// lines twice. The lines themselves are ordinary OrderItems.
model OrderRound {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  itemCount      Int      @default(0)
  fired          Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([orderId])
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String
  // The configured option ordered (drives add-on stock consumption).
  optionId    String?
  priceDelta  Decimal   @default(0)

  @@index([orderItemId])
}

// Append-only payment record. Refunds are separate rows; success is set
// server-side only (never trusted from the client). See PaymentProvider.
model Payment {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method         String // CASH | UPI | CARD | WALLET | ONLINE | OTHER
  status         String    @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED | PARTIAL
  amount         Decimal
  providerRef    String?
  provider       String? // mock | razorpay | stripe
  verifiedAt     DateTime?
  actorId        String?
  /// Client Idempotency-Key: a retried creation returns this payment instead of a second one.
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime  @default(now())

  refunds Refund[]

  /// Provider references are only unique within one tenant (two restaurants' POS/gateway accounts may reuse ids).
  @@unique([organizationId, provider, providerRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
  @@index([orderId])
}

model Refund {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Decimal
  reason         String?
  // Client-supplied key so a retried refund request cannot post twice.
  idempotencyKey String?
  // Gateway refund id (refund executed at / reported by the payment provider).
  providerRef    String?
  actorId        String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, providerRef])
  @@index([paymentId])
  @@index([organizationId, outletId])
}

// ============================================================
// KOT / KDS
// ============================================================

model KitchenStation {
  id             String  @id @default(cuid())
  organizationId String
  outletId       String
  name           String // "Main Kitchen", "Bar"
  kind           String  @default("KITCHEN")
  active         Boolean @default(true)

  kots Kot[]

  @@unique([outletId, name])
  @@index([organizationId, outletId])
}

model Kot {
  id             String          @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId      String?
  station        KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  number         Int
  status         String          @default("NEW") // NEW | ACCEPTED | PREPARING | READY | SERVED | CANCELLED
  printedAt      DateTime?
  // Lifecycle stamps (set once, by the transition that reaches the state): prep
  // time = readyAt - createdAt, measured, not estimated.
  acceptedAt     DateTime?
  startedAt      DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items KotItem[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([orderId])
  @@index([stationId])
}

model KotItem {
  id          String     @id @default(cuid())
  kotId       String
  kot         Kot        @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  name        String
  qty         Decimal    @default(1)
  status      String     @default("NEW")
  notes       String?

  @@index([kotId])
  @@index([orderItemId]) // "is this line on a KOT?" — without it every round/bill read seq-scanned KotItem (SSI relation lock)
}

// ============================================================
// PROCUREMENT (procure-to-pay)
// ============================================================

model PurchaseIndent {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  departmentId   String?
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | CLOSED | CANCELLED
  notes          String?
  // "REORDER" when raised from the reorder screen; null = made by hand.
  source         String?
  // Client Idempotency-Key for creation (reorder raise): a retry with the same
  // key + request returns the original indent; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PurchaseIndentLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model PurchaseIndentLine {
  id             String         @id @default(cuid())
  organizationId String
  indentId       String
  indent         PurchaseIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  unitId         String?

  @@index([indentId])
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  vendorId       String
  status         String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ORDERED | PARTIAL | RECEIVED | BILLED | CLOSED | CANCELLED
  expectedDate   DateTime?
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  total          Decimal   @default(0)
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  // The approved indent this PO was raised from (raising the PO closes it).
  indentId       String?
  // "REORDER" when raised from the reorder screen; null = made by hand.
  source         String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  // Two-person approval (ProcurementSettings.dualApprovalAtOrAbove): the first approver, kept until a different second one approves.
  firstApprovedById String?
  firstApprovedAt   DateTime?
  // Approved by the small-order rule at submission (nobody approved it by hand).
  autoApproved   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([indentId])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  organizationId String
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  taxPct         Decimal       @default(0)
  receivedQty    Decimal       @default(0)
  unitId         String?
  // ACTIVE | REJECTED: an approver can take a line off the order without rejecting the rest. A rejected line is not billed
  // in the order's total, cannot be received and is not counted as on order.
  lineStatus     String        @default("ACTIVE")
  // The quantity as raised, kept when an approver changed it.
  requestedQty   Decimal?

  @@index([poId])
  @@index([materialId])
}

model GoodsReceipt {
  id             String         @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  vendorId       String
  status         String         @default("DRAFT") // DRAFT | POSTED (posting writes the inventory ledger)
  receivedAt     DateTime       @default(now())
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  postedAt       DateTime?
  createdAt      DateTime       @default(now())

  lines GoodsReceiptLine[]
  bills PurchaseBill[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
  @@index([poId])
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  organizationId String
  grnId          String
  grn            GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  damagedQty     Decimal      @default(0)
  batchNo        String?
  expiryDate     DateTime?
  // FSSAI lot code printed on the pack (traceability for a recall).
  fssaiLot       String?
  unitId         String?

  @@index([grnId])
  @@index([materialId])
}

model PurchaseBill {
  id              String        @id @default(cuid())
  organizationId  String
  outletId        String
  number          String
  vendorId        String
  grnId           String?
  grn             GoodsReceipt? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  billDate        DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @default(0)
  tax             Decimal       @default(0)
  total           Decimal       @default(0)
  paidAmount      Decimal       @default(0)
  status          String        @default("OPEN") // OPEN | PARTIAL | PAID | CANCELLED
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey  String?
  requestHash     String?
  // The vendor's own invoice number: at most one bill per vendor invoice.
  vendorInvoiceNo String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines    PurchaseBillLine[]
  payments VendorPayment[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, vendorId, vendorInvoiceNo])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
  @@index([grnId])
}

model PurchaseBillLine {
  id             String       @id @default(cuid())
  organizationId String
  billId         String
  bill           PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  taxPct         Decimal      @default(0)

  @@index([billId])
}

model VendorPayment {
  id             String        @id @default(cuid())
  organizationId String
  outletId       String
  vendorId       String
  billId         String?
  bill           PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  amount         Decimal
  method         String        @default("BANK") // CASH | BANK | UPI | CHEQUE
  reference      String?
  // Client-supplied key so a retried payment request cannot post twice.
  idempotencyKey String?
  paidAt         DateTime      @default(now())
  actorId        String?
  // Reversal (bounced cheque / returned transfer): the payment stops counting
  // against its bill; the row is kept.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime      @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId])
  @@index([vendorId])
  @@index([billId])
}

// ============================================================
// INVENTORY LEDGER (append-only — the single source of truth)
// ============================================================

model InventoryLedger {
  id             String            @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  materialId     String
  material       Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unitId         String?
  unit           Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // OPENING_BALANCE | PURCHASE_RECEIPT | SALE_CONSUMPTION | ISSUE |
  // TRANSFER_OUT | TRANSFER_IN | PRODUCTION_CONSUMPTION | PRODUCTION_OUTPUT |
  // WASTAGE | SPOILAGE | STAFF_MEAL | COUNT_ADJUSTMENT | RETURN | OTHER_ADJUSTMENT
  txnType        String
  // Signed quantity in base unit: positive = stock in, negative = stock out.
  qty            Decimal
  rate           Decimal           @default(0) // unit cost at time of movement
  amount         Decimal           @default(0) // qty * rate (signed)
  // Provenance
  sourceType     String? // GRN | ORDER | TRANSFER | ISSUE | WASTAGE | COUNT | PRODUCTION | MANUAL
  sourceId       String?
  // Idempotency guard: a unique source reference means the same business
  // event can never write two consumption rows. Duplicate webhook => no-op.
  sourceRef      String?           @unique
  batchNo        String?
  expiryDate     DateTime?
  fssaiLot       String?
  note           String?
  // Correction chain (append-only): a mistake is fixed with a new row.
  correctionOfId String?
  correctionOf   InventoryLedger?  @relation("LedgerCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections    InventoryLedger[] @relation("LedgerCorrection")
  actorId        String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, outletId, materialId])
  @@index([materialId, createdAt])
  @@index([outletId, txnType])
  @@index([sourceType, sourceId])
  @@index([correctionOfId])
}

// ============================================================
// STOCK OPERATIONS (each posts to the ledger)
// ============================================================

model InventoryTransfer {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  fromOutletId   String
  toOutletId     String
  status         String    @default("DRAFT") // DRAFT | DISPATCHED | RECEIVED | CANCELLED
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())

  lines InventoryTransferLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([fromOutletId])
  @@index([toOutletId])
}

model InventoryTransferLine {
  id             String            @id @default(cuid())
  organizationId String
  transferId     String
  transfer       InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  materialId     String
  requestedQty   Decimal
  dispatchedQty  Decimal           @default(0)
  receivedQty    Decimal           @default(0)
  damagedQty     Decimal           @default(0)
  unitId         String?

  @@index([transferId])
  @@index([materialId])
}

model InventoryIssue {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  number           String
  fromDepartmentId String?
  toDepartmentId   String?
  status           String    @default("DRAFT") // DRAFT | ISSUED | CANCELLED
  notes            String?
  // The approved indent this issue fulfils (the kitchen asked, the store dispatched).
  indentId         String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey   String?
  requestHash      String?
  createdById      String?
  issuedAt         DateTime?
  createdAt        DateTime  @default(now())

  lines InventoryIssueLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([indentId])
}

model InventoryIssueLine {
  id             String         @id @default(cuid())
  organizationId String
  issueId        String
  issue          InventoryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  unitId         String?

  @@index([issueId])
  @@index([materialId])
}

model Wastage {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  number         String
  reason         String   @default("SPOILAGE") // SPOILAGE | SPILLAGE | PREP_LOSS | EXPIRED | DAMAGED | STAFF_MEAL | OVERPRODUCTION | OTHER
  status         String   @default("POSTED") // DRAFT | POSTED | CANCELLED (posting writes the ledger)
  // Dish-level wastage ("3 pizzas"): the lines are the dish's recipe exploded
  // to raw materials; these record what was wasted as the guest would name it.
  menuItemId     String?
  dishQty        Decimal?
  // When the loss happened, if earlier than the entry (worksheet for an
  // earlier business day); posting dates the ledger rows to it.
  occurredAt     DateTime?
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  createdAt      DateTime @default(now())

  lines WastageLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId])
}

model WastageLine {
  id             String  @id @default(cuid())
  organizationId String
  wastageId      String
  wastage        Wastage @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  estCost        Decimal @default(0)
  unitId         String?

  @@index([wastageId])
  @@index([materialId])
}

model StockCount {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  number         String
  status         String    @default("DRAFT") // DRAFT | COUNTING | REVIEW | APPROVED | CANCELLED
  frozenAt       DateTime? // when book quantities were snapshotted
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines StockCountLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model StockCountLine {
  id             String     @id @default(cuid())
  organizationId String
  countId        String
  count          StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  materialId     String
  bookQty        Decimal    @default(0) // frozen snapshot — never overwritten after approval
  physicalQty    Decimal    @default(0)
  variance       Decimal    @default(0)
  costImpact     Decimal    @default(0)
  unitId         String?

  @@index([countId])
  @@index([materialId])
}

/// Dish production worksheet (proposal module 05): one row per dish per outlet
/// business day. The chef enters prepared portions; sold comes from settled
/// orders; wasted = posted dish-wastage documents of that day (the wastage
/// register is the only path that moves stock); variance = prepared - sold -
/// wasted is the unexplained gap. `wastedQty` and `revision` are unused since
/// group 3 (kept: the column shipped in migration 20261012100000_core_gaps).
model DishProduction {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  /// Outlet business day ("YYYY-MM-DD").
  businessDate   String
  menuItemId     String
  preparedQty    Decimal  @default(0)
  wastedQty      Decimal  @default(0)
  /// Bumped on every save that changes wastedQty (ledger sourceRef revision).
  revision       Int      @default(0)
  notes          String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([outletId, businessDate, menuItemId])
  @@index([organizationId, outletId, businessDate])
}

model ProductionBatch {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  // Kitchen department making the batch: inputs leave it, output enters it
  // (null = the outlet's unassigned stock, as before group 3).
  departmentId     String?
  number           String
  recipeVersionId  String?
  outputMaterialId String
  plannedQty       Decimal
  actualQty        Decimal   @default(0)
  batchNo          String?
  expiryDate       DateTime?
  status           String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | CANCELLED
  createdById      String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  // Client Idempotency-Key: a double-submitted plan returns the first batch.
  idempotencyKey   String?
  requestHash      String?

  lines ProductionLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model ProductionLine {
  id             String          @id @default(cuid())
  organizationId String
  batchId        String
  batch          ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal // consumed input quantity
  unitId         String?

  @@index([batchId])
  @@index([materialId])
}

// ============================================================
// FINANCE
// ============================================================

model Expense {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  category       String // RENT | UTILITIES | SALARY | REPAIRS | MISC ...
  amount         Decimal
  description    String?
  paidVia        String    @default("CASH") // CASH | BANK | UPI | PETTY_CASH
  attachmentUrl  String?
  spentAt        DateTime  @default(now())
  // Client Idempotency-Key: a retried submission returns the original row.
  idempotencyKey String?
  requestHash    String?
  // Void (correction): voided expenses leave every total; the row is kept.
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, spentAt])
}

// Append-only petty-cash ledger.
model PettyCashTxn {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  type           String // OPENING | ADD | EXPENSE | ADJUST
  amount         Decimal // signed: + in, - out
  category       String?
  reason         String?
  attachmentUrl  String?
  approvedById   String?
  actorId        String?
  // Client Idempotency-Key: a retried submission returns the original row.
  idempotencyKey String?
  requestHash    String?
  // The expense this movement paid (a voided expense posts an opposite movement).
  expenseId      String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
}

model CashDrawerSession {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  openedById     String?
  openingFloat   Decimal   @default(0)
  closingCount   Decimal?
  status         String    @default("OPEN") // OPEN | CLOSED
  // Frozen at close: expected = float + net cash sales + pay-ins − pay-outs.
  expectedCash   Decimal?
  variance       Decimal?
  closedById     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  movements CashDrawerMovement[]

  @@index([organizationId, outletId, status])
}

model Reconciliation {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  businessDate   DateTime
  // PAYMENTS (counted collections per method) | POS (provider orders vs local)
  // | GATEWAY (payment provider vs local payments) | AGGREGATOR (settlements vs
  // expected payouts) | VENDOR (bills vs vendor payments) | SALES (revenue
  // billed per channel vs declared by the manager at day close)
  kind           String   @default("PAYMENTS")
  status         String   @default("DRAFT") // DRAFT | COMPLETED (completed = locked)
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines ReconciliationLine[]

  @@unique([outletId, businessDate, kind])
  @@index([organizationId, outletId])
}

model ReconciliationLine {
  id               String         @id @default(cuid())
  organizationId   String
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  // PAYMENTS: the payment method. Other kinds: the compared item's reference
  // (e.g. "order:<externalRef>", "payment:<providerRef>", "bill:<number>", "TOTAL").
  method           String
  expected         Decimal        @default(0)
  actual           Decimal        @default(0)
  difference       Decimal        @default(0)
  note             String?

  @@index([reconciliationId])
}

/// Money that reached the bank for a sales day (proposal module 06, "actually
/// deposited"): a cash deposit slip, or the UPI / card settlement credited for
/// that day. Never edited or deleted: a wrong entry is voided with a reason
/// and a new one recorded.
model BankDeposit {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  /// Sales day the money came from (UTC midnight of the outlet-local date, like Reconciliation).
  businessDate   DateTime
  method         String    @default("CASH") // CASH | UPI | CARD
  depositedAt    DateTime
  amount         Decimal
  reference      String
  bankAccount    String?
  notes          String?
  status         String    @default("RECORDED") // RECORDED | VOIDED
  voidReason     String?
  voidedById     String?
  voidedAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  idempotencyKey String?
  requestHash    String?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, businessDate])
}

/// Daily close (proposal module 06): one row per close of an outlet business
/// day. `snapshot` freezes the day's figures (JSON). While the latest revision
/// is CLOSED the day refuses changes; reopening (with a reason) marks it
/// REOPENED and keeps it, and the next close is a new revision.
model DayClose {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  businessDate   DateTime
  revision       Int       @default(1)
  status         String    @default("CLOSED") // CLOSED | REOPENED
  snapshot       String
  notes          String?
  closedById     String?
  closedAt       DateTime  @default(now())
  reopenedById   String?
  reopenedAt     DateTime?
  reopenReason   String?

  @@unique([outletId, businessDate, revision])
  @@index([organizationId, outletId, businessDate])
}

// ============================================================
// AGGREGATORS
// ============================================================

model Aggregator {
  id             String  @id @default(cuid())
  organizationId String
  name           String // ZOMATO | SWIGGY | ...
  commissionPct  Decimal @default(0)
  active         Boolean @default(true)

  orders      AggregatorOrder[]
  settlements AggregatorSettlement[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AggregatorOrder {
  id             String     @id @default(cuid())
  organizationId String
  outletId       String
  aggregatorId   String
  aggregator     Aggregator @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  externalId     String
  orderId        String? // linked internal order
  grossAmount    Decimal    @default(0)
  discount       Decimal    @default(0)
  commission     Decimal    @default(0)
  tax            Decimal    @default(0)
  platformFee    Decimal    @default(0)
  netPayout      Decimal    @default(0)
  placedAt       DateTime   @default(now())

  @@unique([aggregatorId, externalId])
  @@index([organizationId, outletId])
}

model AggregatorSettlement {
  id             String     @id @default(cuid())
  organizationId String
  outletId       String
  aggregatorId   String
  aggregator     Aggregator @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  periodFrom     DateTime
  periodTo       DateTime
  expectedPayout Decimal    @default(0)
  actualPayout   Decimal    @default(0)
  difference     Decimal    @default(0)
  createdAt      DateTime   @default(now())

  @@index([organizationId, outletId])
  @@index([aggregatorId])
}

// ============================================================
// PEOPLE
// ============================================================

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  userId         String
  checkIn        DateTime
  checkOut       DateTime?
  status         String    @default("PRESENT") // PRESENT | LATE | ABSENT | LEAVE
  note           String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, outletId, userId])
  @@index([userId, checkIn])
}

model Shift {
  id             String @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  startTime      String // "09:00"
  endTime        String // "17:00"

  assignments ShiftAssignment[]

  @@index([organizationId, outletId])
}

/// Who works which shift on which day (the roster). One person once per shift per day.
model ShiftAssignment {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  shiftId        String
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId         String
  /// The calendar day at the outlet, YYYY-MM-DD.
  date           String
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([shiftId, userId, date])
  @@index([organizationId, outletId, date])
  @@index([userId, date])
}

/// A reusable duty list (opening, closing, training): a named set of items that becomes one task per item each time it is started.
model ChecklistTemplate {
  id             String                  @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  /// OPENING | CLOSING | TRAINING | OTHER
  kind           String                  @default("OPENING")
  active         Boolean                 @default(true)
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          ChecklistTemplateItem[]

  @@unique([outletId, name])
  @@index([organizationId, outletId])
}

model ChecklistTemplateItem {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String            @default("MEDIUM")
  sortOrder   Int               @default(0)

  @@index([templateId])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  userId         String
  fromDate       DateTime
  toDate         DateTime
  reason         String?
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, userId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  title          String
  description    String?
  assignedToId   String?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | VERIFIED | CANCELLED
  dueAt          DateTime?
  completedById  String?
  completedAt    DateTime?
  verifiedById   String?
  createdById    String?
  /// Set when the task came from a checklist: which template item, and for which day. Starting a checklist twice for a day makes each task once.
  templateItemId String?
  runDate        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([templateItemId, runDate])
  @@index([organizationId, outletId, status])
  @@index([assignedToId])
}

// ============================================================
// INTEGRATIONS / SYSTEM / OBSERVABILITY
// ============================================================

// Idempotency + audit for inbound webhooks (POS, payments, aggregators).
model WebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  provider       String // petpooja | razorpay | zomato | ...
  eventId        String // provider's unique event/order id
  eventType      String?
  signatureValid Boolean   @default(false)
  status         String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | DUPLICATE
  payload        String // raw JSON
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  // The core idempotency guard for inbound events.
  @@unique([provider, eventId])
  @@index([status])
  @@index([provider, receivedAt])
}

// POS items sold with no recipe mapping — surfaced, never silently dropped.
model UnmappedSale {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  posCode          String
  posName          String?
  qty              Decimal   @default(0)
  source           String    @default("POS")
  status           String    @default("OPEN") // OPEN | MAPPED | IGNORED
  mappedMenuItemId String?
  resolvedById     String?
  resolvedAt       DateTime?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@unique([outletId, source, posCode])
  @@index([organizationId, outletId, status])
}

model IntegrationConnection {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String?
  kind             String // POS | PAYMENT | AGGREGATOR | SHEETS | WHATSAPP | EMAIL
  provider         String
  status           String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  // Config holds NON-secret settings only.
  config           String? // JSON
  /// The provider's identifier for THIS tenant's account/store (Petpooja restID,
  /// aggregator store id, gateway merchant account id). Inbound webhooks are
  /// bound to a tenant ONLY through this mapping — never through ids in the body.
  externalRef      String?
  /// Optional per-tenant webhook signing secret, AES-256-GCM encrypted
  /// (server/integrations/secrets.ts). When set, the deployment-wide provider
  /// secret is NOT accepted for this tenant.
  webhookSecretEnc String?
  /// SANDBOX | LIVE — what the operator declared; adapters that cannot reach a
  /// live provider never report LIVE (see docs/phase7-integrations.md).
  mode             String    @default("SANDBOX")
  /// Provider API credentials (JSON), AES-256-GCM encrypted. Write-only.
  credentialsEnc   String?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  /// Safe, secret-free message of the last failure.
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, outletId, kind, provider])
  /// One provider account maps to exactly one tenant.
  @@unique([kind, provider, externalRef])
  @@index([organizationId])
}

model SyncJob {
  id             String    @id @default(cuid())
  organizationId String
  kind           String // SHEETS_PUSH | SHEETS_PULL | RECONCILE
  status         String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED
  direction      String? // PUSH | PULL
  detail         String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, kind, status])
}

model ExportJob {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  kind           String // report id: DAILY_SALES | ITEM_SALES | INVENTORY | PNL | ...
  format         String    @default("CSV")
  status         String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED | EXPIRED (EXPORT_TRANSITIONS)
  filePath       String? // opaque storage key "<orgId>/<jobId>.csv" (never a filesystem path, never sent to clients); null = inline CSV / purged
  params         String? // JSON of the validated filters (no secrets)
  rowCount       Int?
  error          String? // safe, user-facing message only (internal errors are logged, not stored)
  requestedById  String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime? // claimed by a runner (PENDING -> RUNNING)
  finishedAt     DateTime? // SUCCESS / FAILED
  expiresAt      DateTime? // stored file is removed after this (EXPORT_RETENTION_HOURS)
  purgedAt       DateTime? // SUCCESS -> EXPIRED by retention cleanup

  @@index([organizationId, kind])
  @@index([status, createdAt])
}

model Anomaly {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  departmentId   String?
  type           String // NEGATIVE_STOCK | COUNT_VARIANCE | PRICE_SPIKE | UNMAPPED_ITEM | HEAVY_WASTAGE
  severity       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  entityType     String?
  entityId       String?
  message        String
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED
  resolvedById   String?
  resolutionNote String?
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, outletId, status])
  @@index([type, severity])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  userId         String? // null => broadcast to org/outlet
  channel        String    @default("IN_APP") // IN_APP | EMAIL | WHATSAPP | PUSH
  type           String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  reads NotificationRead[]

  @@index([organizationId, outletId])
  @@index([userId, readAt])
}

/// Per-user read receipt for a BROADCAST notification (userId = null on the
/// notification). Personal notifications keep using Notification.readAt.
model NotificationRead {
  id             String       @id @default(cuid())
  organizationId String
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([organizationId, userId])
}

// Append-only audit trail. Normal users can never delete these rows.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String?
  actorId        String?
  action         String // CREATE | UPDATE | VOID | APPROVE | REJECT | LOGIN | LOGOUT | PAYMENT | REFUND | ...
  entityType     String
  entityId       String?
  before         String? // JSON snapshot
  after          String? // JSON snapshot
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ============================================================
// Phase 4 — finance
// ============================================================

/// Expense categories per organization (defaults provisioned on first use).
model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
}

/// Non-sale cash in / out of an open drawer (float top-up, cash paid out).
model CashDrawerMovement {
  id             String            @id @default(cuid())
  organizationId String
  outletId       String
  sessionId      String
  session        CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type           String // PAY_IN | PAY_OUT
  amount         Decimal
  reason         String
  actorId        String?
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime          @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([sessionId])
  @@index([organizationId, outletId, createdAt])
}

/// Gapless invoice / credit-note counters per outlet, financial year and kind.
model InvoiceSequence {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  fiscalYear     String // "2026-27"
  kind           String // INVOICE | CREDIT_NOTE
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, fiscalYear, kind])
}

/// An issued invoice or credit note: immutable tax snapshot (GST-ready data).
model TaxInvoice {
  id                String   @id @default(cuid())
  organizationId    String
  outletId          String
  orderId           String
  kind              String // INVOICE | CREDIT_NOTE
  number            String
  fiscalYear        String
  seq               Int
  /// Exactly-once key: "inv:<orderId>" or "cn:<refundId>".
  sourceKey         String   @unique
  originalInvoiceId String?
  refundId          String?
  issuedAt          DateTime @default(now())
  sellerName        String
  sellerAddress     String?
  sellerGstin       String?
  sellerStateCode   String?
  buyerName         String?
  buyerGstin        String?
  /// State code of the place of supply.
  placeOfSupply     String?
  supplyType        String // INTRA (CGST+SGST) | INTER (IGST) | UNREGISTERED (no GST)
  taxableValue      Decimal
  cgst              Decimal  @default(0)
  sgst              Decimal  @default(0)
  igst              Decimal  @default(0)
  totalTax          Decimal
  total             Decimal
  reason            String?
  createdById       String?

  lines TaxInvoiceLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, issuedAt])
  @@index([orderId])
}

model TaxInvoiceLine {
  id             String     @id @default(cuid())
  organizationId String
  invoiceId      String
  invoice        TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ratePct        Decimal
  hsnSac         String?
  taxableValue   Decimal
  cgst           Decimal    @default(0)
  sgst           Decimal    @default(0)
  igst           Decimal    @default(0)

  @@index([invoiceId])
}

// ============================================================
// PHASE 7 — PRINTERS / CASH DRAWER / OUTBOUND INTEGRATIONS
// ============================================================

/// A receipt / KOT printer at an outlet. Transport NETWORK_ESCPOS = raw ESC/POS
/// over TCP to a LAN printer (IP literal in a private range); SIMULATED = no
/// hardware (jobs are rendered and kept, never reported as printed on paper).
model Printer {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  /// RECEIPT | KOT
  role           String    @default("RECEIPT")
  /// KOT printers: the kitchen station they print for (null = every station).
  station        String?
  /// NETWORK_ESCPOS | SIMULATED
  transport      String    @default("SIMULATED")
  host           String?
  port           Int       @default(9100)
  /// Characters per line (58 mm = 32, 80 mm = 42/48).
  width          Int       @default(42)
  /// A cash drawer is wired to this printer's kick port.
  cashDrawer     Boolean   @default(false)
  /// KOT printers: print new tickets automatically.
  autoPrint      Boolean   @default(true)
  active         Boolean   @default(true)
  /// ONLINE | OFFLINE | UNKNOWN (last probe / job)
  lastStatus     String    @default("UNKNOWN")
  lastError      String?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs PrintJob[]

  @@unique([outletId, name])
  @@index([organizationId, outletId])
}

/// One print (or drawer-kick) attempt series. dedupeKey makes the FIRST print of
/// a receipt / KOT on a printer happen once; reprints are separate, audited jobs.
model PrintJob {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  printerId      String
  printer        Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  /// RECEIPT | KOT | TEST | DRAWER
  kind           String
  sourceType     String?
  sourceId       String?
  dedupeKey      String
  /// QUEUED | PRINTED | SIMULATED | FAILED
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  lastError      String?
  /// Rendered text (no secrets; what was / would be printed).
  content        String
  reprintOfId    String?
  reason         String?
  requestedById  String?
  createdAt      DateTime  @default(now())
  printedAt      DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, outletId, status])
  @@index([sourceType, sourceId])
  @@index([printerId])
}

/// Outbound integration work (customer messages, aggregator status pushes,
/// accounting vouchers): idempotent per (organization, idempotencyKey), with a
/// bounded attempt count and the provider's reference / failure reason.
model IntegrationDelivery {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  /// MESSAGE | AGGREGATOR_STATUS | ACCOUNTING_VOUCHER
  kind           String
  provider       String
  /// MOCK | SANDBOX | LIVE — fixed when the delivery is created
  mode           String
  idempotencyKey String
  /// Masked destination (e.g. +91******3210); never a credential.
  target         String?
  /// Secret-free JSON of what is / was sent.
  payload        String
  /// PENDING | SENT | DELIVERED | FAILED | SKIPPED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime?
  lastError      String?
  providerRef    String?
  sourceType     String?
  sourceId       String?
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, kind, status])
  @@index([provider, providerRef])
}

// ============================================================
// GROUP 5: ACCOUNTING MAPPING, SHEETS SYNC, AGGREGATOR CONTROL ROOM, SCHEDULED JOBS
// ============================================================

/// Ledger and party names as the organization's books call them. Applied to
/// every accounting file and sync, so RESTORA's "Sales" can land in the
/// accountant's "Sales - Dine In" (proposal p. 12: "CSV exports for Tally,
/// Zoho Books, or your CA's own format").
model AccountingMapping {
  id             String   @id @default(cuid())
  organizationId String   @unique
  /// JSON { "<RESTORA ledger>": "<books ledger / account name or id>" }
  ledgers        String   @default("{}")
  /// JSON { "<party as RESTORA names it>": "<books party / contact>" }
  parties        String   @default("{}")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Google Sheets two-way sync (proposal p. 12): the state of one row of one
/// dataset as RESTORA last wrote it to / read it from the sheet. A row changed
/// on BOTH sides since then is a conflict, never silently overwritten.
model SheetSyncRow {
  id             String   @id @default(cuid())
  organizationId String
  dataset        String
  rowKey         String
  syncedHash     String
  syncedAt       DateTime
  @@unique([organizationId, dataset, rowKey])
}

model SheetSyncConflict {
  id             String    @id @default(cuid())
  organizationId String
  dataset        String
  rowKey         String
  /// JSON of the row in RESTORA and in the sheet when the conflict was found.
  restoraValue   String
  sheetValue     String
  /// OPEN | KEPT_RESTORA | TOOK_SHEET
  status         String    @default("OPEN")
  detectedAt     DateTime  @default(now())
  resolvedById   String?
  resolvedAt     DateTime?
  @@index([organizationId, status])
}

/// One line of an aggregator payout statement, imported from the platform's
/// partner dashboard export (no partner API): what the platform says it paid
/// for one order, and what it deducted (proposal p. 17 aggregator control room).
model AggregatorStatementLine {
  id              String   @id @default(cuid())
  organizationId  String
  outletId        String
  aggregatorId    String
  /// The statement / payout reference the line came from.
  statementRef    String
  externalId      String
  settledAt       DateTime
  grossAmount     Decimal  @default(0)
  commission      Decimal  @default(0)
  penalty         Decimal  @default(0)
  adSpend         Decimal  @default(0)
  otherDeductions Decimal  @default(0)
  netPayout       Decimal  @default(0)
  importedById    String?
  importedAt      DateTime @default(now())
  @@unique([aggregatorId, statementRef, externalId])
  @@index([organizationId, outletId, settledAt])
}

/// A cost charged by an aggregator outside any one order: an ad campaign, a
/// monthly fee, a penalty (proposal p. 17: "commission, penalty and ad-spend
/// tracked as real costs"). Voided, never deleted.
model AggregatorCharge {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  aggregatorId   String
  /// PENALTY | AD_SPEND | FEE | OTHER
  kind           String
  amount         Decimal
  chargedOn      DateTime
  reference      String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  idempotencyKey String?
  requestHash    String?
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, chargedOn])
}

/// One run of a scheduled job per scope per day (e.g. the nightly POS re-pull
/// per outlet, proposal p. 7). The unique key makes "once a day" hold across
/// several app instances.
model JobRun {
  id         String    @id @default(cuid())
  name       String
  scopeKey   String
  runDate    String
  /// RUNNING | SUCCESS | FAILED
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Secret-free JSON summary or error.
  detail     String?
  @@unique([name, scopeKey, runDate])
}

// ============================================================
// GROUP 6: GROWTH, CRM AND COMMUNICATIONS (proposal pp. 16-17)
// ============================================================

/// Who may be messaged, per channel. Marketing needs an explicit yes; messages about the guest's
/// own order, booking or bill go out unless the guest opted out of that channel.
model CustomerConsent {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// SMS | WHATSAPP | EMAIL
  channel        String
  marketing      Boolean  @default(false)
  transactional  Boolean  @default(true)
  /// STAFF | GUEST_QR | IMPORT | GUEST_REPLY
  source         String   @default("STAFF")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([customerId, channel])
  @@index([organizationId, channel, marketing])
}

/// One row per organization: every rule of the growth programme in one place.
model GrowthSettings {
  organizationId        String   @id
  referralEnabled       Boolean  @default(false)
  referrerPoints        Int      @default(100)
  refereePoints         Int      @default(50)
  referralMinOrderValue Decimal  @default(0)
  referralMonthlyCap    Int      @default(20)
  birthdayCouponId      String?
  anniversaryCouponId   String?
  winbackCouponId       String?
  /// Guests whose last paid order is older than this many days get the win-back message (proposal: 45).
  winbackAfterDays      Int      @default(45)
  /// ...and are not asked again for this many days.
  winbackCooldownDays   Int      @default(90)
  feedbackEnabled       Boolean  @default(false)
  feedbackDelayMinutes  Int      @default(120)
  /// Shown only to guests who rated 4 or 5 (https only).
  googleReviewUrl       String?
  /// A rating at or below this reaches the manager privately and is never sent to a public site.
  lowRatingMax          Int      @default(3)
  /// Marketing is never sent in the guest's night: hours in the outlet's time zone (start inclusive, end exclusive).
  quietHoursStart       Int      @default(21)
  quietHoursEnd         Int      @default(9)
  /// At most this many marketing messages per guest in any 7 days.
  marketingWeeklyCap    Int      @default(2)
  /// Booking confirmation and a reminder before the table (off until the owner turns it on).
  bookingMessagesEnabled Boolean @default(false)
  bookingReminderHours  Int      @default(2)
  digestEnabled         Boolean  @default(false)
  digestHour            Int      @default(9)
  /// Where the 9 AM summary goes besides the in-app notification (E.164, optional).
  digestPhone           String?
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

/// Tiers with perks (proposal p. 17). Without any row the legacy lifetime-points thresholds apply.
model LoyaltyTier {
  id                String   @id @default(cuid())
  organizationId    String
  code              String
  name              String
  /// Spend on paid orders over the last 365 days that reaches this tier.
  minSpend          Decimal  @default(0)
  /// 100 = standard earn rule, 150 = 1.5x points.
  earnMultiplierPct Decimal  @default(100)
  /// What the guest gets, in words (shown to staff and on the guest's profile).
  perks             String?
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

/// A code the guest or the cashier types; the server prices it, the client never does.
model Coupon {
  id               String    @id @default(cuid())
  organizationId   String
  /// Upper case, unique per organization.
  code             String
  name             String
  description      String?
  /// PERCENT | FIXED
  kind             String
  value            Decimal
  /// Cap on a PERCENT coupon.
  maxDiscount      Decimal?
  minOrderValue    Decimal?
  validFrom        DateTime?
  validTo          DateTime?
  /// Total redemptions allowed (null = unlimited).
  usageLimit       Int?
  perCustomerLimit Int?
  firstOrderOnly   Boolean   @default(false)
  /// A tier code: only guests at that tier or above.
  minTier          String?
  /// Comma separated order channels (null = every channel).
  channels         String?
  /// Comma separated outlet ids (null = every outlet).
  outletIds        String?
  /// May sit on an order that already carries a manual discount.
  stackable        Boolean   @default(false)
  active           Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redemptions CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model CouponRedemption {
  id             String    @id @default(cuid())
  organizationId String
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId        String
  customerId     String?
  amount         Decimal
  /// APPLIED | REVERSED
  status         String    @default("APPLIED")
  reversedAt     DateTime?
  reverseReason  String?
  createdAt      DateTime  @default(now())

  @@unique([orderId, couponId])
  @@index([couponId, status])
  @@index([organizationId, customerId])
}

/// A guest's own code to share. One per customer.
model ReferralCode {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  code           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, customerId])
  @@unique([organizationId, code])
}

/// Who brought whom. A guest can be referred once, ever.
model Referral {
  id                 String    @id @default(cuid())
  organizationId     String
  referrerCustomerId String
  referredCustomerId String
  codeId             String
  /// PENDING (waiting for the first paid order) | REWARDED | REJECTED
  status             String    @default("PENDING")
  rejectReason       String?
  qualifyingOrderId  String?
  referrerPoints     Int?
  refereePoints      Int?
  createdAt          DateTime  @default(now())
  rewardedAt         DateTime?

  @@unique([organizationId, referredCustomerId])
  @@index([organizationId, referrerCustomerId, status])
}

/// The question sent after a visit (proposal p. 17: "2 hours later"), one per paid order.
model FeedbackRequest {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  customerId     String?
  /// The unguessable part of the feedback link.
  token          String
  /// PENDING | SENT | ANSWERED | SKIPPED | EXPIRED
  status         String    @default("PENDING")
  skipReason     String?
  dueAt          DateTime
  sentAt         DateTime?
  answeredAt     DateTime?
  feedbackId     String?
  createdAt      DateTime  @default(now())

  @@unique([orderId])
  @@unique([token])
  @@index([organizationId, status, dueAt])
}

/// A message to a segment of guests who said yes to marketing on that channel.
model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// SMS | WHATSAPP | EMAIL
  channel        String
  /// MANUAL | BIRTHDAY | ANNIVERSARY | WINBACK
  kind           String    @default("MANUAL")
  /// JSON: who (segment, minimum orders / spend, last order before N days, birthday month ...).
  audience       String
  body           String
  couponId       String?
  /// DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  status         String    @default("DRAFT")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  recipientCount Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([organizationId, status, scheduledAt])
}

model CampaignRecipient {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId     String
  /// QUEUED | SENT | DELIVERED | FAILED | SKIPPED
  status         String   @default("QUEUED")
  skipReason     String?
  deliveryId     String?
  createdAt      DateTime @default(now())

  @@unique([campaignId, customerId])
  @@index([organizationId, customerId])
}

/// Approval rules for purchase orders, per organization (audit PP-07). Both limits are optional; with neither set every
/// order waits for one approver, as before.
model ProcurementSettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  /// A purchase order at or below this total is approved when it is submitted.
  autoApproveBelow      Decimal?
  /// A purchase order at or above this total needs two different approvers.
  dualApprovalAtOrAbove Decimal?
  updatedById           String?
  updatedAt             DateTime @updatedAt
}
